# Python / experiment artefacts
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.env
data/raw/
# instances.jsonl is tracked: it pins which graphs/tasks were sampled, so an
# upstream change to the HuggingFace Erdos dataset cannot silently alter results.
# variants.jsonl is derived from it deterministically, so it is regenerated.
data/processed/*/variants.jsonl
results/*
!results/*/
results/*/*
!results/*/tables/
!results/*/figs/
# Keep the review scripts and evidence alongside the published analysis.
!results/review/*.py
!results/review/*.json
!results/review/*.csv
# Repeat-prompt floors and the checksum manifests of the team dataset are cited by ANALYSIS.md.
!results/floor*.json
!results/hf_snapshot_yoni/*/
!results/hf_snapshot_yoni/*/manifest.json
# Regenerated by scripts/audit_results.py (29 MB); paired_intervals.csv and summary.json are the results.
results/review/per_instance.csv
# The stub smoke run (README, scripts/verify.py) is not a result.
results/smoke/

